---
import Base from '../../layouts/Base.astro';
import Note from '../../components/Note.astro';
import { getNotes, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await getNotes()).map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
---
<Base title={`Note, ${formatDate(note.data.date)}`} backdrop={note.data.images[0]?.src}>
  <section class="panel glass page-head">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/notes/">Notes</a><span aria-hidden="true">/</span></nav>
    <Note note={note} />
  </section>
</Base>
