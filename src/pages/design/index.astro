---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import BackdropHover from '../../components/BackdropHover.astro';
import { getDesign } from '../../lib/content';

const all = await getDesign();
const groups = [
  { title: 'Case studies', items: all.filter((e) => e.data.kind === 'case-study') },
  { title: 'Illustration', items: all.filter((e) => e.data.kind === 'illustration') },
  { title: 'Branding', items: all.filter((e) => e.data.kind === 'branding') },
].filter((g) => g.items.length > 0);
---
<Base title="Design" description="Design case studies and illustration by Indrayudh Sengupta." backdrop={all.find((e) => e.data.cover)?.data.cover}>
  <header class="panel glass page-head">
    <h1 class="display h1">Design</h1>
    <p class="lede">Product, UX and visual design, mostly for the public and social sector. <a href="/about/">CV and contact</a>.</p>
  </header>
  {groups.map((g) => (
    <section class="panel glass">
      <div class="sec-h"><h2 class="display h2">{g.title}</h2></div>
      <ul class="cards">
        {g.items.map((e) => (
          <Card href={`/design/${e.id}/`} title={e.data.title} summary={e.data.summary} cover={e.data.cover}
            meta={String(e.data.year)} />
        ))}
      </ul>
    </section>
  ))}
  <BackdropHover />
</Base>
