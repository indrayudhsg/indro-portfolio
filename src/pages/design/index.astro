---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getDesign } from '../../lib/content';

const all = await getDesign();
const groups = [
  { title: 'Case studies', items: all.filter((e) => e.data.kind === 'case-study') },
  { title: 'Illustration', items: all.filter((e) => e.data.kind === 'illustration') },
  { title: 'Branding', items: all.filter((e) => e.data.kind === 'branding') },
].filter((g) => g.items.length > 0);
---
<Base title="Design" description="Design case studies and illustration by Indrayudh Sengupta.">
  <h1>Design</h1>
  <p class="prose quiet">Product, UX and visual design, mostly for the public and social sector. <a href="/about/">CV and contact</a>.</p>
  {groups.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <ul class="grid">
        {g.items.map((e) => (
          <Card href={`/design/${e.id}/`} title={e.data.title} summary={e.data.summary} cover={e.data.cover}
            meta={[e.data.client, e.data.year].filter(Boolean).join(' · ')} />
        ))}
      </ul>
    </section>
  ))}
</Base>
