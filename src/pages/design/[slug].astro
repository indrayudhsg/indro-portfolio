---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import { getDesign } from '../../lib/content';

export async function getStaticPaths() {
  return (await getDesign()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <article>
    <p class="quiet"><a href="/design/">Design</a></p>
    <h1>{d.title}</h1>
    <p class="prose">{d.summary}</p>
    <dl class="facts">
      {d.client && <><dt>Client</dt><dd>{d.client}</dd></>}
      <dt>Year</dt><dd>{d.year}</dd>
      {d.role && <><dt>Role</dt><dd>{d.role}</dd></>}
    </dl>
    {d.cover && <img src={d.cover} alt="" />}
    <div class="prose"><Content /></div>
    {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
    <ProcessStrip projectId={entry.id} />
  </article>
</Base>
