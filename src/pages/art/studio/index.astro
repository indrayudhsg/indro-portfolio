---
import Base from '../../../layouts/Base.astro';
import StudioGrid from '../../../components/StudioGrid.astro';
import { getStudio } from '../../../lib/content';
import { studioMedia } from '../../../content.config';

const pieces = await getStudio();
const media = studioMedia.filter((m) => pieces.some((p) => p.data.medium === m));
---
<Base title="Studio" description="Etchings, prints, watercolours and crafts by Indrayudh Sengupta.">
  <p class="quiet"><a href="/art/">Art</a></p>
  <h1>Studio</h1>
  <p class="prose quiet">Etchings, prints, watercolours and things made by hand. Process lives in <a href="/notes/">Notes</a>.</p>
  <StudioGrid pieces={pieces} media={media} />
</Base>
