---
import Base from '../../../../layouts/Base.astro';
import StudioGrid from '../../../../components/StudioGrid.astro';
import BackdropHover from '../../../../components/BackdropHover.astro';
import { getStudio, mediumLabel } from '../../../../lib/content';
import { studioMedia } from '../../../../content.config';

export async function getStaticPaths() {
  const pieces = await getStudio();
  const media = studioMedia.filter((m) => pieces.some((p) => p.data.medium === m));
  return media.map((m) => ({ params: { medium: m }, props: { media, pieces: pieces.filter((p) => p.data.medium === m) } }));
}
const { medium } = Astro.params;
const { media, pieces } = Astro.props;
---
<Base title={`${mediumLabel[medium]} · Studio`} backdrop={pieces[0]?.data.images[0]?.src}>
  <header class="panel glass page-head">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/art/">Art</a><span aria-hidden="true">/</span><a href="/art/studio/">Studio</a><span aria-hidden="true">/</span></nav>
    <h1 class="display h1">{mediumLabel[medium]}</h1>
  </header>
  <section class="panel glass"><StudioGrid pieces={pieces} media={media} current={medium} /></section>
  <BackdropHover />
</Base>
