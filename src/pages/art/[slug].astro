---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import { getArt } from '../../lib/content';

export async function getStaticPaths() {
  return (await getArt()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary} backdrop={d.cover}>
  <Entry crumbs={[{ href: '/art/', label: 'Art' }]} title={d.title} summary={d.summary} tags={d.tags}
    facts={[['Year', String(d.year)], ['Medium', d.medium], ['Size', d.dimensions]]}>
    <Content />
    <Fragment slot="aside">
      {d.exhibitions.length > 0 && (
        <dl class="facts shown"><dt>Shown</dt><dd>{d.exhibitions.map((x) => <div>{x.title}, {x.place}, {x.date}</div>)}</dd></dl>
      )}
      {d.credits.length > 0 && <p class="credits">{d.credits.join(' · ')}</p>}
    </Fragment>
    <ProcessStrip slot="after" projectId={entry.id} />
  </Entry>
</Base>

<style>
  .shown { margin-top: 14px; }
  .credits { margin: 16px 0 0; font-family: var(--mono); font-size: 0.76rem; color: var(--fg-quiet); }
</style>
