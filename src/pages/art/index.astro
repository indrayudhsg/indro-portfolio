---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getArt } from '../../lib/content';

const all = await getArt();
const works = all.filter((e) => e.data.kind === 'work');
const curatorial = all.filter((e) => e.data.kind === 'curatorial');
---
<Base title="Art" description="Art works and curatorial projects by Indrayudh Sengupta.">
  <h1>Art</h1>
  <p class="prose quiet">
    <!-- TODO: artist statement, two or three sentences. -->
    Installations and sound works about nature, technology and care.
  </p>
  <section>
    <h2>Works</h2>
    <ul class="grid">
      {works.map((e) => (
        <Card href={`/art/${e.id}/`} title={e.data.title} summary={e.data.summary} cover={e.data.cover}
          meta={[e.data.medium, e.data.year].filter(Boolean).join(' · ')} />
      ))}
    </ul>
  </section>
  {curatorial.length > 0 && (
    <section>
      <h2>Curatorial</h2>
      <ul class="grid">
        {curatorial.map((e) => (
          <Card href={`/art/${e.id}/`} title={e.data.title} summary={e.data.summary} cover={e.data.cover} meta={String(e.data.year)} />
        ))}
      </ul>
    </section>
  )}
</Base>
