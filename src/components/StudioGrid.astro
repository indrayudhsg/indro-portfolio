---
import type { CollectionEntry } from 'astro:content';
import { mediumLabel } from '../lib/content';

interface Props {
  pieces: CollectionEntry<'studio'>[];
  media: string[]; // media that have at least one piece, for the filter
  current?: string;
}
const { pieces, media, current } = Astro.props;
---
<nav class="filter" aria-label="Filter by medium">
  <a href="/art/studio/" aria-current={!current ? 'page' : undefined}>All</a>
  {media.map((m) => (
    <a href={`/art/studio/medium/${m}/`} aria-current={current === m ? 'page' : undefined}>{mediumLabel[m]}</a>
  ))}
</nav>
<ul class="studio">
  {pieces.map((p) => (
    <li>
      <a href={`/art/studio/${p.id}/`}>
        <div class="img">{p.data.images[0] && <img src={p.data.images[0].src} alt={p.data.images[0].alt} loading="lazy" />}</div>
        <span class="t">{p.data.title}</span>
        <span class="quiet">{p.data.technique ?? mediumLabel[p.data.medium]}, {p.data.year}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; }
  .filter a { border: 1px solid var(--rule); border-radius: 999px; padding: 4px 14px; text-decoration: none; font-size: 0.9rem; }
  .filter a[aria-current='page'] { border-color: var(--ink); }
  .studio { list-style: none; padding: 0; margin: 0; display: grid; gap: 24px 16px; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .studio a { display: flex; flex-direction: column; gap: 2px; text-decoration: none; }
  .img { aspect-ratio: 1; background: var(--rule); margin-bottom: 8px; overflow: hidden; }
  .img img { width: 100%; height: 100%; object-fit: contain; }
  .t { font-weight: 500; }
  .quiet { font-size: 0.85rem; }
</style>
